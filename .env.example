# انسخه إلى .env للتجربة المحلية فقط، وفي Render ضع القيم من لوحة Environment
BOT_TOKEN=
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
ADMIN_IDS=123456789
GEMINI_API_KEYS=key1,key2
WEBHOOK_SECRET=any_random_string_123
# اختياري
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite
DEFAULT_CC=963
# للتحكم بالكود من الدردشة (اختياري)
GITHUB_TOKEN=
GITHUB_REPO=username/repo
